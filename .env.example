# GEMINI_API_KEY: Optional (not required by UniVault core flows).
GEMINI_API_KEY=

# APP_URL: Optional deployment URL for reverse-proxy origin verification.
APP_URL=

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=
CLASSIFICATION_HMAC_SECRET=
AUDIT_ANCHOR_INTERVAL_MINUTES=15

# SQLite Database (persistent file on disk)
DATABASE_PATH=./data/univault.db

# Storage Abstraction ("local" | "azure")
STORAGE_PROVIDER=local

# Local Private Storage (must remain outside public frontend assets)
LOCAL_STORAGE_PATH=./storage/private

# Optional Azure Blob Storage Configuration (only used when STORAGE_PROVIDER=azure)
# Provide EITHER AZURE_STORAGE_CONNECTION_STRING OR AZURE_STORAGE_ACCOUNT_NAME (DefaultAzureCredential).
# Never expose these values to the frontend or commit real secrets.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=univault-private-docs
